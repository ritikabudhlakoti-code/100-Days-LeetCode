class Solution {
    void fun( int i , int[] nums , List<Integer> op ,List<List<Integer>> ans){
       if(i>= nums.length){
        ans.add(new ArrayList<>(op));
        return;
       }
       op.add(nums[i]);
       fun(i+1,nums,op,ans);
       op.remove(op.size()-1);
       fun(i+1,nums,op,ans);
    }
     public List<List<Integer>>subsets(int []nums){  
        List<Integer> op = new ArrayList<>();
        List<List<Integer>> ans = new ArrayList<>();
        fun( 0 , nums, op,ans);
        return ans;
     }
}
