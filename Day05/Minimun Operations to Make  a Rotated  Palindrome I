 class Solution {
    int fun(String s ){
        int cost = 0 ; 
        int i = 0 ;
        int j = s.length()-1;
        while(i<j){
            if(s.charAt(i)!=s.charAt(j)){
                int a1= s.charAt(i)-'a';
                int a2 = s.charAt(j)-'a';
                int c1 = Math.abs(a1-a2);
                int c2 =  Math.min(c1,26-c1);
                cost += c2;
            }
            i++;
            j--;
                }
        return cost ;}
       
    public int minOperations(String s) {
         int m = Integer.MAX_VALUE;
        for(int i = 0 ; i<s.length();i++){
           
            int cost = fun(s)+i;
            m = Math.min(m,cost);
          s = s.substring(1)+s.charAt(0);
        }
        return m ; 
        
    }
 }
